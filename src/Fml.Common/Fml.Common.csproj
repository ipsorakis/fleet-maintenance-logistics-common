<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Fml.Common</PackageId>
    <Version>0.1.1</Version>
    <Authors>Fleet Maintenance &amp; Logistics</Authors>
    <Description>Cross-cutting building blocks shared by Fleet Maintenance &amp; Logistics services: user/auth contracts, password and token helpers, OpenTelemetry primitives and configuration readers.</Description>
    <PackageTags>fml;fleet;auth;observability</PackageTags>
    <RepositoryUrl>https://github.com/ipsorakis/fleet-maintenance-logistics-common</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
  </ItemGroup>

</Project>
